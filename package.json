{
  "name": "byte-phantom",
  "version": "1.10.0",
  "private": true,
  "description": "BYTE PHANTOM — local-first Cybersecurity & Network Intelligence workstation with cross-platform private-LAN discovery, persistent history, and a live observed-network map.",
  "scripts": {
    "start": "npx serve web",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win portable",
    "assets:generate": "python scripts/generate-brand-assets.py",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "serve": "14.2.4",
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.varagod.bytephantom.desktop",
    "productName": "BYTE PHANTOM",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "web/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/byte-phantom.ico"
    },
    "portable": {
      "artifactName": "BYTE-PHANTOM-v${version}-Windows-${arch}.${ext}"
    },
    "compression": "normal"
  }
}
